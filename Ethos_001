5. scripts/generate_manifest.py

This generates the SHA-256 provenance record.

#!/usr/bin/env python3

"""
ETHOS-BITCOIN-002
Generate a distribution provenance manifest.
"""

from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import sys


MASTER_NAME = "Ethos_Bitcoin"
DISTRIBUTION_NAME = "Copy of Ethos_Bitcoin"

MANIFEST_NAME = "distribution_manifest.json"


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def validate_filename(path: Path) -> None:
    if path.name == MASTER_NAME:
        raise ValueError(
            "The Master cannot be used as a distribution artifact."
        )

    if path.name != DISTRIBUTION_NAME:
        raise ValueError(
            f"Expected '{DISTRIBUTION_NAME}', got '{path.name}'."
        )


def main() -> None:
    if len(sys.argv) != 2:
        print(
            "Usage:\n"
            "  python scripts/generate_manifest.py "
            "\"Copy of Ethos_Bitcoin\""
        )
        sys.exit(2)

    artifact = Path(sys.argv[1])

    if not artifact.exists():
        print(f"ERROR: File does not exist: {artifact}")
        sys.exit(1)

    validate_filename(artifact)

    checksum = sha256_file(artifact)

    timestamp = datetime.now(timezone.utc).isoformat()

    manifest = {
        "schema_version": "1.0",
        "node_id": "ETHOS-BITCOIN-002",
        "project": "Steezy Ethos Bitcoin",
        "authority": {
            "master_filename": MASTER_NAME,
            "master_distribution_allowed": False
        },
        "distribution": {
            "filename": DISTRIBUTION_NAME,
            "distribution_allowed": True
        },
        "artifact": {
            "filename": artifact.name,
            "sha256": checksum,
            "size_bytes": artifact.stat().st_size
        },
        "provenance": {
            "source_role": "MASTER",
            "derived_role": "DISTRIBUTION",
            "relationship": "CONTROLLED_COPY"
        },
        "release": {
            "version": "UNRELEASED",
            "created_at_utc": timestamp,
            "status": "UNRELEASED"
        }
    }

    output = Path(MANIFEST_NAME)

    with output.open("w", encoding="utf-8") as file:
        json.dump(manifest, file, indent=2)
        file.write("\n")

    print("PASS: Manifest generated.")
    print(f"Manifest: {output}")
    print(f"SHA-256: {checksum}")


if __name__ == "__main__":
    main()


