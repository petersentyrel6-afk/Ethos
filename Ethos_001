8. .github/workflows/distribution-check.yml

This makes GitHub automatically run the controls.

name: Ethos Bitcoin Distribution Check

on:
  push:
    branches:
      - main
      - master

  pull_request:
    branches:
      - main
      - master

permissions:
  contents: read

jobs:
  validate-distribution:
    name: Validate Distribution Artifact
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Locate distribution artifact
        id: locate
        shell: bash
        run: |
          set -euo pipefail

          matches="$(find . -type f -name 'Copy of Ethos_Bitcoin' \
            -not -path './.git/*')"

          count="$(printf '%s\n' "$matches" | \
            sed '/^$/d' | wc -l)"

          if [ "$count" -ne 1 ]; then
            echo "ERROR: Expected exactly one Distribution Copy."
            echo "Found:"
            printf '%s\n' "$matches"
            exit 1
          fi

          artifact="$(printf '%s\n' "$matches")"

          echo "artifact=$artifact" >> "$GITHUB_OUTPUT"

      - name: Reject Master artifact
        shell: bash
        run: |
          set -euo pipefail

          if find . -type f -name 'Ethos_Bitcoin' \
            -not -path './.git/*' | grep -q .; then

            echo "ERROR: Master artifact detected."
            echo "The file 'Ethos_Bitcoin' must never be distributed."
            exit 1
          fi

          echo "PASS: Master artifact not present."

      - name: Validate distribution filename
        run: |
          python scripts/validate_distribution.py \
            "${{ steps.locate.outputs.artifact }}"

      - name: Generate verification manifest
        run: |
          cp "${{ steps.locate.outputs.artifact }}" \
             "./Copy of Ethos_Bitcoin"

          python scripts/generate_manifest.py \
            "./Copy of Ethos_Bitcoin"

      - name: Verify integrity
        run: |
          python scripts/verify_integrity.py \
            "./Copy of Ethos_Bitcoin"

      - name: Display manifest
        run: |
          cat distribution_manifest.json

