This prepares a release directory while explicitly refusing the Master.

#!/usr/bin/env python3

"""
ETHOS-BITCOIN-002
Prepare a controlled distribution release.

This script never modifies the Master.
"""

from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import shutil
import sys


MASTER_NAME = "Ethos_Bitcoin"
DISTRIBUTION_NAME = "Copy of Ethos_Bitcoin"

RELEASE_ROOT = Path("release")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def fail(message: str) -> None:
    print(f"ERROR: {message}")
    sys.exit(1)


def main() -> None:
    if len(sys.argv) != 2:
        print(
            "Usage:\n"
            "  python scripts/prepare_release.py "
            "\"Copy of Ethos_Bitcoin\""
        )
        sys.exit(2)

    source = Path(sys.argv[1])

    if not source.exists():
        fail(f"Source artifact does not exist: {source}")

    if not source.is_file():
        fail("Source artifact is not a regular file.")

    if source.name == MASTER_NAME:
        fail(
            "MASTER PROTECTION TRIGGERED. "
            "The Master cannot be released."
        )

    if source.name != DISTRIBUTION_NAME:
        fail(
            f"Only '{DISTRIBUTION_NAME}' may be released."
        )

    checksum = sha256_file(source)

    timestamp = datetime.now(timezone.utc)
    version = timestamp.strftime("release-%Y%m%d-%H%M%S")

    release_dir = RELEASE_ROOT / version

    if release_dir.exists():
        fail(f"Release directory already exists: {release_dir}")

    release_dir.mkdir(parents=True)

    destination = release_dir / DISTRIBUTION_NAME

    shutil.copy2(source, destination)

    manifest = {
        "schema_version": "1.0",
        "node_id": "ETHOS-BITCOIN-002",
        "project": "Steezy Ethos Bitcoin",
        "release": {
            "version": version,
            "created_at_utc": timestamp.isoformat(),
            "status": "READY"
        },
        "artifact": {
            "filename": DISTRIBUTION_NAME,
            "sha256": checksum,
            "size_bytes": destination.stat().st_size
        },
        "authority": {
            "master_filename": MASTER_NAME,
            "master_distribution_allowed": False,
            "distribution_filename": DISTRIBUTION_NAME
        },
        "provenance": {
            "source_role": "MASTER",
            "derived_role": "DISTRIBUTION",
            "relationship": "CONTROLLED_COPY"
        }
    }

    manifest_path = release_dir / "distribution_manifest.json"

    with manifest_path.open("w", encoding="utf-8") as file:
        json.dump(manifest, file, indent=2)
        file.write("\n")

    print("PASS: Release package prepared.")
    print(f"Release: {release_dir}")
    print(f"Artifact: {destination}")
    print(f"SHA-256: {checksum}")
    print("Master modified: NO")


if __name__ == "__main__":
    main()


