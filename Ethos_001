6. scripts/verify_integrity.py

This checks whether the distributed artifact still matches the recorded hash.

#!/usr/bin/env python3

"""
ETHOS-BITCOIN-002
Verify distribution artifact integrity.
"""

from pathlib import Path
import hashlib
import json
import sys


MASTER_NAME = "Ethos_Bitcoin"
DISTRIBUTION_NAME = "Copy of Ethos_Bitcoin"
MANIFEST_NAME = "distribution_manifest.json"


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def fail(message: str) -> None:
    print(f"INTEGRITY FAILURE: {message}")
    sys.exit(1)


def main() -> None:
    if len(sys.argv) != 2:
        print(
            "Usage:\n"
            "  python scripts/verify_integrity.py "
            "\"Copy of Ethos_Bitcoin\""
        )
        sys.exit(2)

    artifact = Path(sys.argv[1])

    if not artifact.exists():
        fail(f"Artifact does not exist: {artifact}")

    if artifact.name == MASTER_NAME:
        fail("The Master cannot be verified as a distribution artifact.")

    if artifact.name != DISTRIBUTION_NAME:
        fail(
            f"Unauthorized artifact. Expected '{DISTRIBUTION_NAME}'."
        )

    manifest_path = Path(MANIFEST_NAME)

    if not manifest_path.exists():
        fail(f"Manifest does not exist: {manifest_path}")

    try:
        with manifest_path.open("r", encoding="utf-8") as file:
            manifest = json.load(file)
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"Unable to read manifest: {exc}")

    recorded_filename = manifest.get("artifact", {}).get("filename")
    recorded_hash = manifest.get("artifact", {}).get("sha256")

    if recorded_filename != DISTRIBUTION_NAME:
        fail(
            "Manifest does not identify the authorized "
            "distribution artifact."
        )

    if not recorded_hash:
        fail("Manifest contains no SHA-256 checksum.")

    actual_hash = sha256_file(artifact)

    if actual_hash.lower() != recorded_hash.lower():
        fail(
            "SHA-256 mismatch.\n"
            f"Recorded: {recorded_hash}\n"
            f"Actual:   {actual_hash}"
        )

    print("PASS: Integrity verified.")
    print(f"Artifact: {artifact}")
    print(f"SHA-256: {actual_hash}")


if __name__ == "__main__":
    main()


