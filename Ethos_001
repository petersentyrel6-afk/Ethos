4. scripts/validate_distribution.py

This is the primary fail-closed gate.

#!/usr/bin/env python3

"""
ETHOS-BITCOIN-002
Distribution validation gate.

Only the designated Distribution Copy may pass.

MASTER:
    Ethos_Bitcoin

DISTRIBUTION:
    Copy of Ethos_Bitcoin
"""

from pathlib import Path
import sys


MASTER_NAME = "Ethos_Bitcoin"
DISTRIBUTION_NAME = "Copy of Ethos_Bitcoin"


def fail(message: str) -> None:
    print(f"ERROR: {message}")
    sys.exit(1)


def validate_distribution(path_string: str) -> Path:
    path = Path(path_string)

    if not path.exists():
        fail(f"Artifact does not exist: {path}")

    if not path.is_file():
        fail(f"Artifact is not a regular file: {path}")

    filename = path.name

    # Hard Master protection.
    if filename == MASTER_NAME:
        fail(
            "MASTER ARTIFACT REJECTED. "
            f"'{MASTER_NAME}' is never eligible for distribution."
        )

    # Only the designated distribution artifact is accepted.
    if filename != DISTRIBUTION_NAME:
        fail(
            f"Unauthorized distribution artifact: '{filename}'. "
            f"Expected exactly: '{DISTRIBUTION_NAME}'."
        )

    print("PASS: Distribution artifact validated.")
    print(f"Artifact: {path}")
    print(f"Role: DISTRIBUTION")
    print(f"Master protected: {MASTER_NAME}")

    return path


def main() -> None:
    if len(sys.argv) != 2:
        print(
            "Usage:\n"
            "  python scripts/validate_distribution.py "
            "\"Copy of Ethos_Bitcoin\""
        )
        sys.exit(2)

    validate_distribution(sys.argv[1])


if __name__ == "__main__":
    main()


